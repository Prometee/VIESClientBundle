{
    "name": "prometee/vies-client-bundle",
    "description": "European VAT Information Exchange System SOAP client bundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Francis HILAIRE",
            "email": "Prometee@users.noreply.github.com"
        }
    ],
    "require": {
        "prometee/vies-client": "^1.0",
        "symfony/http-kernel": "^7.4|^8.1",
        "symfony/dependency-injection": "^7.4|^8.1",
        "symfony/config": "^7.4|^8.1",
        "symfony/validator": "^7.4|^8.1"
    },
    "require-dev": {
        "ext-soap": "*",
        "phpunit/phpunit": "^11|^12|^13",
        "symplify/easy-coding-standard": "^13",
        "phpstan/extension-installer": "^1.0",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-symfony": "^2"
    },
    "autoload": {
        "psr-4": {
            "Prometee\\VIESClientBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Prometee\\VIESClientBundle\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "symfony/flex": false,
            "symfony/runtime": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0-dev"
        }
    }
}
